# https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact-form inquiries
CONTACT_TO_EMAIL=info@businesslinkgroup.com

# Must be a verified Resend sender.
# Until businesslinkgroup.com is verified, use:
#   Business Link LLC <onboarding@resend.dev>
# After verifying the domain:
#   Business Link LLC <info@businesslinkgroup.com>
CONTACT_FROM_EMAIL=Business Link LLC <onboarding@resend.dev>
